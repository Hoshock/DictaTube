{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "holo-shadowing",
  "compatibility_date": "2026-07-22",
  "main": "./worker/index.ts",
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "holo-shadowing",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "db",
    },
  ],
}
