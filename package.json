{
  "name": "dictatube",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "preview": "vp preview",
    "type-check": "vue-tsc --build && tsc -p tsconfig.worker.json",
    "test": "vitest run",
    "lint": "vp lint . --fix",
    "format": "vp fmt src/ worker/ shared/",
    "cf-typegen": "wrangler types",
    "postinstall": "wrangler types",
    "prepare": "vp config --no-agent"
  },
  "dependencies": {
    "vue": "^3.5.32",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.46.0",
    "@tailwindcss/vite": "^4.3.0",
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^24.12.2",
    "@types/youtube": "^0.3.0",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/tsconfig": "^0.9.1",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.0",
    "vite": "catalog:",
    "vite-plugin-vue-devtools": "^8.1.1",
    "vite-plus": "catalog:",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.2.6",
    "wrangler": "^4.113.0"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "workerd"
    ]
  }
